MONGO_URI=mongodb://localhost:27017/kol-emet
API_PORT=3004
NODE_ENV=development
SESSION_SECRET=change-me-to-a-64-char-random-string
CLIENT_ORIGIN=http://localhost:5173
# Domain the session cookie is scoped to. Leave it unset (or blank) for a
# host-only cookie: the right default for localhost and for any deployment whose
# client and API answer on the same host. Set it when they are on sibling
# subdomains of one registrable domain — a leading dot, e.g.
# `.kol-emet.example.com`, so a cookie the API sets is also sent from the
# client's origin. A value that is not a parent of the request host is dropped
# by the browser without an error, which looks like a sign-in that succeeds and
# then lands back on the login form.
# Changing it on a live deployment strands the cookie every signed-in browser
# already holds: the new one does not overwrite the old, and both are sent until
# the old one expires. Clear it on the clients or expect one re-login.
SESSION_COOKIE_DOMAIN=
# Session-cookie logging: off | light | normal | verbose (default light).
# light = the attributes the cookie is built with and where each came from, once
# per app start; normal adds a line per cookie cleared (logout, account
# deletion); verbose adds the domain value and the full attribute set.
SESSION_COOKIE_LOG_LEVEL=
BEARER_TOKEN=change-me
# Required when NODE_ENV=production: the /mcp gate fails closed without it and
# every request to the endpoint answers 503 (it stays open in dev, unset).
MCP_BEARER_TOKEN=change-me-to-a-random-string
# /mcp auth-gate logging: off | light | normal | verbose (default light).
# light = the gate's startup decision and every refusal; normal adds a line per
# request; verbose adds the Authorization header a refused request sent.
MCP_LOG_LEVEL=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Kol Emet
WEBAUTHN_ORIGIN=http://localhost:5173

# Failed sign-in throttling (src/lib/attemptLimiter.js). The values below are
# the shipped defaults: failures per email and per client address inside one
# fixed window, counted on /auth/login, failed passkey sign-ins and failed
# re-authentication for account deletion. Per email is the guessing limit; per
# address is deliberately far higher, because an office or a school is one
# address for many people. Counters live in the API process, so running more
# than one instance multiplies the effective ceiling by the instance count.
AUTH_LIMIT_MAX_PER_EMAIL=10
AUTH_LIMIT_MAX_PER_IP=100
AUTH_LIMIT_WINDOW_MS=900000
# off | light | normal | verbose (default light). light = every block, with the
# kind of key and the route. An email address is never logged at any tier.
AUTH_LIMIT_LOG_LEVEL=

# Primary AI provider (SaaS path — one key, all models, per-request cost data)
OPENROUTER_API_KEY=

# Native provider fallbacks (power users / self-hosted — bring your own keys)
# xAI and OpenAI native providers also unlock the Responses API + MCP tool path
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Self-hosted models on the steadfast-ai box, behind its OpenAI-compatible
# gateway. Only reachable over the tailnet, so leave unset in cloud deploys
# (Railway) — extraction falls back to OpenRouter, then the chat provider.
# When set, background memory extraction routes here instead of paying per call.
STEADFAST_AI_API_KEY=
STEADFAST_AI_BASE_URL=http://100.88.32.7:3011/v1

# Memory-extraction debug logging: off | light | normal | verbose (default light)
MEMORY_LOG_LEVEL=

# MCP server URL for AI tool access (used by the chat endpoint)
MCP_SERVER_URL=https://your-domain.example.com/mcp

# Generator (braindump -> proposed graph)
# Input ceiling; larger inputs need a job queue, not a bigger number.
# Total AI allowance granted to a new workspace, in micro-dollars
# (1000000 = $1.00). Covers generation, in-app chat and memory extraction —
# everything that calls a paid provider. NOT MCP: Claude.ai runs that
# inference on the user's own subscription, so it costs us nothing.
# Self-hosted (steadfast) inference is cheap but NOT free — it is priced from
# measured throughput and electricity. Override the assumptions if they are off:
#   STEADFAST_WATTS=300
#   STEADFAST_KWH_RATE=0.17
AI_TRIAL_GRANT_MICROS=3500000

# Minimum allowance needed to START a generation run (micro-dollars)
GENERATOR_MIN_RUN_MICROS=15000

# off | light | normal (default light)
USAGE_LOG_LEVEL=

GENERATOR_MAX_CHARS=25000
GENERATOR_CHUNK_CHARS=6000
# off | light | normal | verbose (default light)
GENERATOR_LOG_LEVEL=

# Key for pseudonymising ids in draft exports (scripts/export-drafts-jsonl.js,
# GET /drafts/:id/export). No default on purpose: a shared fallback key would
# make the pseudonyms linkable back to real ids by anyone holding the source.
# Keep it stable — changing it renames every pseudonym and breaks joins against
# a corpus already exported.
EXPORT_HMAC_SECRET=
